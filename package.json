    "antd": "^5.4.0",
    "d3": "^7.9.0",
    "fs-extra": "^10.0.0",
    "html-react-parser": "^5.1.18",
    "import-fresh": "^3.3.0",
    "lodash": "^4.17.21",
    "luxon": "^1.25.0",
    "next": "^16.2.4",
    "next-seo": "^6.6.0",
    "next-sitemap": "^4.2.3",
    "react": "^18.3.1",
    "react-css-theme-switcher": "^0.3.0",
