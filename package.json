    "@types/lodash": "^4.17.0",
    "@types/luxon": "^3.4.2",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "cpx": "^1.5.0",
    "eslint": "^9.22.0",
    "eslint-config-next": "^16.2.4",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "trim": "0.0.3",
